<ui:FluentWindow x:Class="DownloadYou.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DownloadYou.Presentation"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:DownloadYou.Presentation.Converters"
        xmlns:vm="clr-namespace:DownloadYou.Presentation.ViewModels"
        xmlns:models="clr-namespace:DownloadYou.Presentation.Models"
        xmlns:enums="clr-namespace:DownloadYou.Domain.Enums;assembly=DownloadYou.Domain"
        mc:Ignorable="d"
        Title="DownloadYou" Height="980" Width="920" MinWidth="760" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <Window.Resources>
        <conv:ThumbnailUrlToImageConverter x:Key="ThumbnailConverter"/>
        <conv:BoolToAppearanceConverter x:Key="BoolToAppearance"/>
        <conv:PercentToStarWidthConverter x:Key="PercentToStar"/>
        <conv:PipelineStepStateToSymbolConverter x:Key="StepSymbol"/>
        <conv:CountToVisibilityConverter x:Key="CountToVis"/>
        <conv:LibraryFilterToAppearanceConverter x:Key="LibraryFilterAppearance"/>
        <conv:EnumToAppearanceConverter x:Key="EnumToAppearance"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="StepIconStyle" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#9AA0A6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter Property="Foreground" Value="#2E7D32"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Current">
                    <Setter Property="Foreground" Value="#0067C0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error">
                    <Setter Property="Foreground" Value="#C62828"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StepLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#9AA0A6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter Property="Foreground" Value="#2E7D32"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Current">
                    <Setter Property="Foreground" Value="#0067C0"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error">
                    <Setter Property="Foreground" Value="#C62828"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="QueueItemTemplate" DataType="{x:Type vm:DownloadJobViewModel}">
            <ui:Card Margin="0,0,0,10">
                <StackPanel MinWidth="380">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="{Binding Title}" FontTypography="BodyStrong" TextWrapping="Wrap"/>
                            <TextBlock FontSize="11" Opacity="0.7" Margin="0,2,0,0">
                                <Run Text="{Binding KindLabel, Mode=OneWay}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding QualityLabel, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="Pausar" Command="{Binding PauseCommand}" IsEnabled="{Binding CanPause}" Padding="8,4"/>
                            <ui:Button Content="Reanudar" Command="{Binding ResumeCommand}" IsEnabled="{Binding CanResume}" Appearance="Primary" Margin="6,0,0,0" Padding="8,4"/>
                            <ui:Button Content="Cancelar" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}" Margin="6,0,0,0" Padding="8,4"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="8" CornerRadius="4" ClipToBounds="True" Background="#22808080" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding ProgressPercent, Converter={StaticResource PercentToStar}}"/>
                                <ColumnDefinition Width="{Binding ProgressPercent, Converter={StaticResource PercentToStar}, ConverterParameter=Remaining}"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Fill="#0067C0"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding SpeedLabel}" FontSize="11" Opacity="0.75"/>
                        <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" FontSize="11" Opacity="0.75" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding EtaLabel}" FontSize="11" Opacity="0.75" HorizontalAlignment="Right"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding PipelineSteps}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="{Binding State, Converter={StaticResource StepSymbol}}"
                                                    Style="{StaticResource StepIconStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource StepLabelStyle}"
                                                Margin="4,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding StatusLabel}" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </ui:Card>
        </DataTemplate>

        <DataTemplate x:Key="HistoryItemTemplate" DataType="{x:Type vm:HistoryEntryViewModel}">
            <ui:Card Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock FontSize="11" Opacity="0.7" Margin="0,2,0,0">
                            <Run Text="{Binding DateLabel, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding KindLabel, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding QualityLabel, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding StatusLabel, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Padding="8,4"
                                   Appearance="{Binding IsFavorite, Converter={StaticResource BoolToAppearance}}"
                                   Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}" ToolTip="Marcar como favorito">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Star24" Filled="{Binding IsFavorite}"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Padding="8,4" Margin="6,0,0,0"
                                   Command="{Binding DataContext.OpenHistoryFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}" ToolTip="Abrir carpeta">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="OpenFolder24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Padding="8,4" Margin="6,0,0,0"
                                   Command="{Binding DataContext.RepeatDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}" ToolTip="Repetir descarga">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowClockwise24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Padding="8,4" Margin="6,0,0,0" Appearance="Danger"
                                   Command="{Binding DataContext.DeleteHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}" ToolTip="Eliminar del historial">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Delete24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </ui:Card>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="DownloadYou">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="ArrowDownload24"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,4,24,24" MaxWidth="760" HorizontalAlignment="Stretch">

                <TextBlock Text="Analiza, descarga y convierte contenido de YouTube."
                           FontSize="13" Opacity="0.65" Margin="0,0,0,16"/>

                <ui:InfoBar Title="Uso responsable"
                            Message="Descarga únicamente contenido propio, de dominio público o con licencia/autorización explícita del titular. Respeta los Términos de Servicio de YouTube y los derechos de autor."
                            Severity="Informational" IsOpen="{Binding ShowLegalDisclaimerBanner, Mode=TwoWay}" IsClosable="True"
                            Margin="0,0,0,16"/>

                <!-- Analizar -->
                <ui:CardControl Margin="0,0,0,12">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Search24"/>
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <ui:TextBlock Text="Analizar" FontTypography="BodyStrong"/>
                    </ui:CardControl.Header>
                    <StackPanel MinWidth="380">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="https://www.youtube.com/watch?v=..." ClearButtonEnabled="True">
                                <ui:TextBox.Icon>
                                    <ui:SymbolIcon Symbol="Link24"/>
                                </ui:TextBox.Icon>
                            </ui:TextBox>
                            <ui:Button Grid.Column="1" Content="Analizar" Command="{Binding AnalyzeCommand}"
                                       Appearance="Primary" Margin="8,0,0,0">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Search24"/>
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                        <TextBlock Text="{Binding AnalysisStatus}" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Opacity="0.75"/>
                    </StackPanel>
                </ui:CardControl>

                <!-- Información -->
                <ui:Card Margin="0,0,0,12" Visibility="{Binding HasMediaInfo, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="6" Background="#22808080" ClipToBounds="True">
                            <Image Source="{Binding MediaInfo.ThumbnailUrl, Converter={StaticResource ThumbnailConverter}}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <ui:TextBlock Text="{Binding MediaInfo.Title}" FontTypography="Subtitle" TextWrapping="Wrap"/>
                            <ui:TextBlock Text="{Binding MediaInfo.Author}" Appearance="Secondary" FontTypography="Body" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- Formato -->
                <ui:CardControl Margin="0,0,0,12" Visibility="{Binding HasMediaInfo, Converter={StaticResource BoolToVis}}">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="List24"/>
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <ui:TextBlock Text="Formato y calidad" FontTypography="BodyStrong"/>
                    </ui:CardControl.Header>
                    <ui:ListView MinWidth="380" Height="200" ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding SelectedFormat}">
                        <ui:ListView.View>
                            <GridView>
                                <GridViewColumn Header="Tipo" DisplayMemberBinding="{Binding Kind}" Width="90"/>
                                <GridViewColumn Header="Calidad" DisplayMemberBinding="{Binding DisplayLabel}" Width="150"/>
                                <GridViewColumn Header="Contenedor" DisplayMemberBinding="{Binding Container}" Width="100"/>
                                <GridViewColumn Header="Id" DisplayMemberBinding="{Binding FormatId}" Width="70"/>
                            </GridView>
                        </ui:ListView.View>
                    </ui:ListView>
                </ui:CardControl>

                <!-- Descarga -->
                <ui:CardControl Margin="0,0,0,12" Visibility="{Binding HasMediaInfo, Converter={StaticResource BoolToVis}}">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="ArrowDownload24"/>
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <ui:TextBlock Text="Descarga" FontTypography="BodyStrong"/>
                    </ui:CardControl.Header>
                    <StackPanel MinWidth="380">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Video" Command="{Binding SelectVideoKindCommand}"
                                       Appearance="{Binding IsVideoKind, Converter={StaticResource BoolToAppearance}}" Margin="0,0,8,0">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Video24"/>
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Content="Audio MP3" Command="{Binding SelectAudioKindCommand}"
                                       Appearance="{Binding IsAudioMp3Kind, Converter={StaticResource BoolToAppearance}}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="MusicNote224"/>
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}">
                                <ui:TextBox.Icon>
                                    <ui:SymbolIcon Symbol="Folder24"/>
                                </ui:TextBox.Icon>
                            </ui:TextBox>
                            <ui:Button Grid.Column="1" Content="Examinar..." Margin="8,0,0,0" Click="BrowseFolder_Click"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:Button Content="Agregar a la cola" Command="{Binding EnqueueCommand}" Appearance="Primary">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowDownload24"/>
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                        <TextBlock Text="{Binding EnqueueStatus}" Margin="0,8,0,0" FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl>

                <!-- Cola de descargas -->
                <ui:CardControl Margin="0,0,0,12" Visibility="{Binding QueueItems.Count, Converter={StaticResource CountToVis}}">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="ArrowSync24"/>
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <ui:TextBlock Text="Cola de descargas" FontTypography="BodyStrong"/>
                    </ui:CardControl.Header>
                    <ItemsControl MinWidth="380" ItemsSource="{Binding QueueItems}" ItemTemplate="{StaticResource QueueItemTemplate}"/>
                </ui:CardControl>

                <!-- Historial -->
                <ui:CardControl Margin="0,0,0,12">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="History24"/>
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <ui:TextBlock Text="Historial" FontTypography="BodyStrong"/>
                    </ui:CardControl.Header>
                    <StackPanel MinWidth="380">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding HistorySearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Buscar por título o URL..." ClearButtonEnabled="True">
                                <ui:TextBox.Icon>
                                    <ui:SymbolIcon Symbol="Search24"/>
                                </ui:TextBox.Icon>
                            </ui:TextBox>
                            <ui:Button Grid.Column="1" Content="Buscar" Command="{Binding SearchHistoryCommand}" Margin="8,0,0,0"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding HistoryEntries}" ItemTemplate="{StaticResource HistoryItemTemplate}" Margin="0,10,0,0"/>

                        <TextBlock Text="No hay descargas en el historial todavía."
                                   Visibility="{Binding HistoryEntries.Count, Converter={StaticResource CountToVis}, ConverterParameter=Invert}"
                                   FontSize="12" Opacity="0.6" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding HistoryStatus}" Margin="0,8,0,0" FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl>

                <!-- Biblioteca -->
                <ui:CardControl Margin="0,0,0,12">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Library24"/>
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <ui:TextBlock Text="Biblioteca" FontTypography="BodyStrong"/>
                    </ui:CardControl.Header>
                    <StackPanel MinWidth="380">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Recientes" Padding="10,5"
                                       Appearance="{Binding SelectedLibraryFilter, Converter={StaticResource LibraryFilterAppearance}, ConverterParameter=Recent}"
                                       Command="{Binding SelectLibraryFilterCommand}" CommandParameter="{x:Static models:LibraryFilter.Recent}"/>
                            <ui:Button Content="Videos" Padding="10,5" Margin="6,0,0,0"
                                       Appearance="{Binding SelectedLibraryFilter, Converter={StaticResource LibraryFilterAppearance}, ConverterParameter=Videos}"
                                       Command="{Binding SelectLibraryFilterCommand}" CommandParameter="{x:Static models:LibraryFilter.Videos}"/>
                            <ui:Button Content="Audio" Padding="10,5" Margin="6,0,0,0"
                                       Appearance="{Binding SelectedLibraryFilter, Converter={StaticResource LibraryFilterAppearance}, ConverterParameter=Audio}"
                                       Command="{Binding SelectLibraryFilterCommand}" CommandParameter="{x:Static models:LibraryFilter.Audio}"/>
                            <ui:Button Content="Favoritos" Padding="10,5" Margin="6,0,0,0"
                                       Appearance="{Binding SelectedLibraryFilter, Converter={StaticResource LibraryFilterAppearance}, ConverterParameter=Favorites}"
                                       Command="{Binding SelectLibraryFilterCommand}" CommandParameter="{x:Static models:LibraryFilter.Favorites}"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding LibraryEntries}" ItemTemplate="{StaticResource HistoryItemTemplate}" Margin="0,10,0,0"/>

                        <TextBlock Text="No hay descargas completadas para esta vista todavía."
                                   Visibility="{Binding LibraryEntries.Count, Converter={StaticResource CountToVis}, ConverterParameter=Invert}"
                                   FontSize="12" Opacity="0.6" Margin="0,10,0,0"/>
                    </StackPanel>
                </ui:CardControl>

                <!-- Configuración -->
                <ui:CardExpander Margin="0,0,0,12" IsExpanded="False">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon Symbol="Settings24"/>
                    </ui:CardExpander.Icon>
                    <ui:CardExpander.Header>
                        <ui:TextBlock Text="Configuración" FontTypography="BodyStrong"/>
                    </ui:CardExpander.Header>
                    <StackPanel MinWidth="380" DataContext="{Binding Settings}">

                        <TextBlock Text="Carpeta de descargas por defecto" FontSize="12" Opacity="0.7" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding DownloadFolder, UpdateSourceTrigger=PropertyChanged}">
                                <ui:TextBox.Icon>
                                    <ui:SymbolIcon Symbol="Folder24"/>
                                </ui:TextBox.Icon>
                            </ui:TextBox>
                            <ui:Button Grid.Column="1" Content="Examinar..." Margin="8,0,0,0" Click="BrowseSettingsFolder_Click"/>
                        </Grid>

                        <TextBlock Text="Tipo de descarga por defecto" FontSize="12" Opacity="0.7" Margin="0,16,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Video" Command="{Binding SelectDefaultVideoCommand}"
                                       Appearance="{Binding IsDefaultVideo, Converter={StaticResource BoolToAppearance}}" Margin="0,0,8,0">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Video24"/>
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Content="Audio MP3" Command="{Binding SelectDefaultAudioCommand}"
                                       Appearance="{Binding IsDefaultAudioMp3, Converter={StaticResource BoolToAppearance}}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="MusicNote224"/>
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>

                        <TextBlock Text="Bitrate de audio por defecto (kbps)" FontSize="12" Opacity="0.7" Margin="0,16,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="128" Command="{Binding SelectAudioBitrateCommand}" CommandParameter="128"
                                       Appearance="{Binding DefaultAudioBitrateKbps, Converter={StaticResource EnumToAppearance}, ConverterParameter=128}" Margin="0,0,6,0" Padding="10,5"/>
                            <ui:Button Content="192" Command="{Binding SelectAudioBitrateCommand}" CommandParameter="192"
                                       Appearance="{Binding DefaultAudioBitrateKbps, Converter={StaticResource EnumToAppearance}, ConverterParameter=192}" Margin="0,0,6,0" Padding="10,5"/>
                            <ui:Button Content="256" Command="{Binding SelectAudioBitrateCommand}" CommandParameter="256"
                                       Appearance="{Binding DefaultAudioBitrateKbps, Converter={StaticResource EnumToAppearance}, ConverterParameter=256}" Margin="0,0,6,0" Padding="10,5"/>
                            <ui:Button Content="320" Command="{Binding SelectAudioBitrateCommand}" CommandParameter="320"
                                       Appearance="{Binding DefaultAudioBitrateKbps, Converter={StaticResource EnumToAppearance}, ConverterParameter=320}" Padding="10,5"/>
                        </StackPanel>

                        <TextBlock Text="Descargas simultáneas (se aplica al reiniciar la app)" FontSize="12" Opacity="0.7" Margin="0,16,0,6"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Command="{Binding DecrementMaxConcurrentCommand}" Padding="8,4">
                                <ui:SymbolIcon Symbol="Subtract24"/>
                            </ui:Button>
                            <TextBlock Text="{Binding MaxConcurrentDownloads}" FontSize="16" FontWeight="SemiBold"
                                       Width="32" TextAlignment="Center" VerticalAlignment="Center" Margin="8,0"/>
                            <ui:Button Command="{Binding IncrementMaxConcurrentCommand}" Padding="8,4">
                                <ui:SymbolIcon Symbol="Add24"/>
                            </ui:Button>
                        </StackPanel>

                        <TextBlock Text="Si el archivo final ya existe" FontSize="12" Opacity="0.7" Margin="0,16,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Renombrar" Command="{Binding SelectExistingFileBehaviorCommand}" CommandParameter="{x:Static enums:ExistingFileBehavior.Rename}"
                                       Appearance="{Binding ExistingFileBehavior, Converter={StaticResource EnumToAppearance}, ConverterParameter=Rename}" Margin="0,0,6,0" Padding="10,5"/>
                            <ui:Button Content="Sobrescribir" Command="{Binding SelectExistingFileBehaviorCommand}" CommandParameter="{x:Static enums:ExistingFileBehavior.Overwrite}"
                                       Appearance="{Binding ExistingFileBehavior, Converter={StaticResource EnumToAppearance}, ConverterParameter=Overwrite}" Margin="0,0,6,0" Padding="10,5"/>
                            <ui:Button Content="Omitir" Command="{Binding SelectExistingFileBehaviorCommand}" CommandParameter="{x:Static enums:ExistingFileBehavior.Skip}"
                                       Appearance="{Binding ExistingFileBehavior, Converter={StaticResource EnumToAppearance}, ConverterParameter=Skip}" Padding="10,5"/>
                        </StackPanel>

                        <TextBlock Text="Plantilla de nombre de archivo" FontSize="12" Opacity="0.7" Margin="0,16,0,6"/>
                        <ui:TextBox Text="{Binding FileNameTemplate, UpdateSourceTrigger=PropertyChanged}">
                            <ui:TextBox.Icon>
                                <ui:SymbolIcon Symbol="DocumentText24"/>
                            </ui:TextBox.Icon>
                        </ui:TextBox>
                        <TextBlock Text="{Binding FileNamePreview}" FontSize="11" Opacity="0.6" Margin="0,4,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="Tema" FontSize="12" Opacity="0.7" Margin="0,16,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Sistema" Command="{Binding SelectThemeCommand}" CommandParameter="{x:Static enums:ThemePreference.System}"
                                       Appearance="{Binding ThemePreference, Converter={StaticResource EnumToAppearance}, ConverterParameter=System}" Margin="0,0,6,0" Padding="10,5">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Desktop24"/>
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Content="Claro" Command="{Binding SelectThemeCommand}" CommandParameter="{x:Static enums:ThemePreference.Light}"
                                       Appearance="{Binding ThemePreference, Converter={StaticResource EnumToAppearance}, ConverterParameter=Light}" Margin="0,0,6,0" Padding="10,5">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="WeatherSunny24"/>
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Content="Oscuro" Command="{Binding SelectThemeCommand}" CommandParameter="{x:Static enums:ThemePreference.Dark}"
                                       Appearance="{Binding ThemePreference, Converter={StaticResource EnumToAppearance}, ConverterParameter=Dark}" Padding="10,5">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="WeatherMoon24"/>
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0" Text="Mostrar aviso de uso responsable" VerticalAlignment="Center"/>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowLegalDisclaimer}"/>
                        </Grid>

                        <TextBlock Text="Idioma: Español (único disponible por ahora)." FontSize="11" Opacity="0.55" Margin="0,16,0,0"/>

                        <ui:Button Content="Guardar" Command="{Binding SaveCommand}" Appearance="Primary" Margin="0,16,0,0">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Save24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <TextBlock Text="{Binding SaveStatus}" Margin="0,8,0,0" FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Diagnóstico y registro -->
                <ui:CardExpander Margin="0,0,0,12" IsExpanded="False">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon Symbol="Wrench24"/>
                    </ui:CardExpander.Icon>
                    <ui:CardExpander.Header>
                        <ui:TextBlock Text="Diagnóstico y registro técnico" FontTypography="BodyStrong"/>
                    </ui:CardExpander.Header>
                    <StackPanel MinWidth="380">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Probar motores (yt-dlp / ffmpeg)" Command="{Binding RunDiagnosticsCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="PlugDisconnected24"/>
                                </ui:Button.Icon>
                            </ui:Button>
                            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding LogLines}" Height="180" Margin="0,10,0,0"
                                 FontFamily="Consolas" FontSize="11" Background="#111" Foreground="#ddd" BorderThickness="0"/>
                    </StackPanel>
                </ui:CardExpander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
