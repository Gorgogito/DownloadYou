<Window x:Class="DownloadYou.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DownloadYou.Presentation"
        xmlns:conv="clr-namespace:DownloadYou.Presentation.Converters"
        mc:Ignorable="d"
        Title="DownloadYou — Prototipo técnico" Height="880" Width="860"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:ThumbnailUrlToImageConverter x:Key="ThumbnailConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="Fase 3 — Descarga" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Analiza una URL, elige calidad y carpeta, y descarga con progreso real (velocidad, tamaño, ETA)."
                       Foreground="#666" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,4">
            <Button Content="Probar motores (yt-dlp / ffmpeg)"
                    Command="{Binding RunDiagnosticsCommand}"
                    Padding="14,6"/>
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold"/>
        </StackPanel>

        <Separator Grid.Row="2" Margin="0,8,0,10"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                      Padding="6" VerticalContentAlignment="Center"
                      ToolTip="https://www.youtube.com/watch?v=..."/>
            <Button Grid.Column="1" Content="Analizar" Command="{Binding AnalyzeCommand}"
                    Padding="14,6" Margin="8,0,0,0"/>
        </Grid>

        <TextBlock Grid.Row="4" Text="{Binding AnalysisStatus}" Margin="0,8,0,10" TextWrapping="Wrap" FontWeight="SemiBold"/>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#EEE" CornerRadius="4">
                <Image Source="{Binding MediaInfo.ThumbnailUrl, Converter={StaticResource ThumbnailConverter}}"
                       Stretch="Uniform" Margin="4"/>
            </Border>

            <ListBox Grid.Column="1" Margin="12,0,0,0" ItemsSource="{Binding AvailableFormats}"
                      SelectedItem="{Binding SelectedFormat}"
                      BorderThickness="1" BorderBrush="#DDD">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Kind}" Foreground="#888" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding DisplayLabel}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="{Binding Container}" Foreground="#888"/>
                            <TextBlock Grid.Column="3" Text="{Binding FormatId}" Foreground="#AAA" FontSize="11"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Separator Grid.Row="6" Margin="0,10,0,10"/>

        <StackPanel Grid.Row="7">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Video" GroupName="Kind" IsChecked="{Binding IsVideoKind}" VerticalAlignment="Center"/>
                <RadioButton Content="Audio MP3" GroupName="Kind" IsChecked="{Binding IsAudioMp3Kind}" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Carpeta:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}"
                          Padding="6" VerticalContentAlignment="Center"/>
                <Button Grid.Column="2" Content="Examinar..." Padding="10,6" Margin="8,0,0,0" Click="BrowseFolder_Click"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Descargar" Command="{Binding DownloadCommand}" Padding="16,6" FontWeight="SemiBold"/>
                <Button Content="Cancelar" Command="{Binding CancelDownloadCommand}" Padding="16,6" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="8" Margin="0,12,0,10">
            <ProgressBar Height="20" Minimum="0" Maximum="100" Value="{Binding DownloadProgressPercent, Mode=OneWay}"/>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DownloadSpeedLabel}"/>
                <TextBlock Grid.Column="1" Text="{Binding DownloadedSizeLabel}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding DownloadEtaLabel}" HorizontalAlignment="Right"/>
            </Grid>
            <TextBlock Text="{Binding DownloadStatus}" Margin="0,6,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </StackPanel>

        <ListBox Grid.Row="9" ItemsSource="{Binding LogLines}"
                  FontFamily="Consolas" FontSize="12" Background="#111" Foreground="#ddd"
                  BorderThickness="0"/>
    </Grid>
</Window>
