<Window x:Class="DownloadYou.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DownloadYou.Presentation"
        xmlns:conv="clr-namespace:DownloadYou.Presentation.Converters"
        mc:Ignorable="d"
        Title="DownloadYou — Prototipo técnico" Height="720" Width="820"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:ThumbnailUrlToImageConverter x:Key="ThumbnailConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="Fase 2 — Análisis de URL y metadatos" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Pega una URL de YouTube para ver título, autor, duración y las calidades realmente disponibles."
                       Foreground="#666" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,4">
            <Button Content="Probar motores (yt-dlp / ffmpeg)"
                    Command="{Binding RunDiagnosticsCommand}"
                    Padding="14,6"/>
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold"/>
        </StackPanel>

        <Separator Grid.Row="2" Margin="0,8,0,10"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                      Padding="6" VerticalContentAlignment="Center"
                      ToolTip="https://www.youtube.com/watch?v=..."/>
            <Button Grid.Column="1" Content="Analizar" Command="{Binding AnalyzeCommand}"
                    Padding="14,6" Margin="8,0,0,0"/>
        </Grid>

        <TextBlock Grid.Row="4" Text="{Binding AnalysisStatus}" Margin="0,8,0,10" TextWrapping="Wrap" FontWeight="SemiBold"/>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#EEE" CornerRadius="4">
                <Image Source="{Binding MediaInfo.ThumbnailUrl, Converter={StaticResource ThumbnailConverter}}"
                       Stretch="Uniform" Margin="4"/>
            </Border>

            <ListBox Grid.Column="1" Margin="12,0,0,0" ItemsSource="{Binding AvailableFormats}"
                      BorderThickness="1" BorderBrush="#DDD">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Kind}" Foreground="#888" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding DisplayLabel}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="{Binding Container}" Foreground="#888"/>
                            <TextBlock Grid.Column="3" Text="{Binding FormatId}" Foreground="#AAA" FontSize="11"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Separator Grid.Row="6" Margin="0,10,0,8"/>

        <ListBox Grid.Row="7" ItemsSource="{Binding LogLines}"
                  FontFamily="Consolas" FontSize="12" Background="#111" Foreground="#ddd"
                  BorderThickness="0"/>
    </Grid>
</Window>
